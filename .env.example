POSTGRES_DB=ragdb
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_super
RAG_OWNER_PASSWORD=change_me_owner
RAG_APP_PASSWORD=change_me_app

# Used by scripts and tests running on the host (compose builds its own URLs)
APP_DATABASE_URL=postgresql+psycopg://rag_app:change_me_app@127.0.0.1:5433/ragdb
MIGRATION_DATABASE_URL=postgresql+psycopg://rag_owner:change_me_owner@127.0.0.1:5433/ragdb

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# LLM: ollama (free, local) | anthropic | gemini
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=180
ANTHROPIC_API_KEY=
GEMINI_API_KEY=